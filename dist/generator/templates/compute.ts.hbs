import * as pulumi from "@pulumi/pulumi";
import * as aws from "@pulumi/aws";
import { prefix, region, rootDomain, ecrImage{{#each servicesWithDomain}}, {{camel name}}Domain{{/each}} } from "../config";
import { privateSubnet1, privateSubnet2, ecsSg } from "./networking";
{{#if hasDatabase}}import { db, dbPassword } from "./store";
{{/if}}{{#if hasCache}}import { redis } from "./store";
{{/if}}{{#if hasStorage}}import { bucket } from "./store";
{{/if}}{{#if hasAlb}}
import {
{{#each servicesWithDomain}}
  {{targetGroupVar}},
{{#if wildcardTargetGroupVar}}  {{wildcardTargetGroupVar}},
{{/if}}{{/each}}
} from "./loadbalancer";
{{/if}}

{{#each allSecrets}}
const {{varName}} = aws.secretsmanager.getSecretOutput({ name: "{{secretName}}" });
{{/each}}

const ecsAssumeRole = JSON.stringify({
  Version: "2012-10-17",
  Statement: [{
    Effect: "Allow",
    Principal: { Service: "ecs-tasks.amazonaws.com" },
    Action: "sts:AssumeRole",
  }],
});

const executionRole = new aws.iam.Role(`${prefix}-ecs-execution-role`, {
  name: `${prefix}-ecs-execution-role`,
  assumeRolePolicy: ecsAssumeRole,
});

new aws.iam.RolePolicyAttachment(`${prefix}-ecs-execution-policy`, {
  role: executionRole.name,
  policyArn: "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy",
});

new aws.iam.RolePolicy(`${prefix}-ecr-cross-account`, {
  role: executionRole.name,
  policy: JSON.stringify({
    Version: "2012-10-17",
    Statement: [{
      Effect: "Allow",
      Action: [
        "ecr:GetAuthorizationToken",
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
      ],
      Resource: "*",
    }],
  }),
});

new aws.iam.RolePolicy(`${prefix}-secrets-read`, {
  role: executionRole.name,
  policy: pulumi.interpolate`{
    "Version": "2012-10-17",
    "Statement": [{
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:${region}:*:secret:${prefix}/*"
    }]
  }`,
});

{{#if hasStorage}}
const s3Policy = pulumi.interpolate`{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow",
    "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
    "Resource": ["${bucket.arn}", "${bucket.arn}/*"]
  }]
}`;
{{/if}}

const ssmPolicy = JSON.stringify({
  Version: "2012-10-17",
  Statement: [{
    Effect: "Allow",
    Action: [
      "ssmmessages:CreateControlChannel",
      "ssmmessages:CreateDataChannel",
      "ssmmessages:OpenControlChannel",
      "ssmmessages:OpenDataChannel",
    ],
    Resource: "*",
  }],
});

{{#each services}}
{{#unless isFrontend}}
const {{camel name}}TaskRole = new aws.iam.Role(`${prefix}-{{name}}-task-role`, {
  name: `${prefix}-{{name}}-task-role`,
  assumeRolePolicy: ecsAssumeRole,
});

{{#if @root.hasStorage}}
{{#if envFromBucket}}
new aws.iam.RolePolicy(`${prefix}-{{name}}-s3-policy`, {
  role: {{camel name}}TaskRole.name,
  policy: s3Policy,
});
{{/if}}
{{/if}}

new aws.iam.RolePolicy(`${prefix}-{{name}}-ssm-policy`, {
  role: {{camel name}}TaskRole.name,
  policy: ssmPolicy,
});
{{/unless}}

new aws.cloudwatch.LogGroup(`${prefix}-{{name}}-logs`, {
  name: `/ecs/${prefix}/{{name}}`,
  retentionInDays: {{@root.ecsDefaults.logRetentionDays}},
});
{{/each}}

export const cluster = new aws.ecs.Cluster(`${prefix}-cluster`, {
  name: `${prefix}-cluster`,
  settings: [{ name: "containerInsights", value: "enabled" }],
  tags: { Name: `${prefix}-cluster` },
});

{{#each services}}
const {{camel name}}Environment = pulumi
  .all([
{{#if envFromDb}}    db.endpoint,
    dbPassword,
{{/if}}{{#if envFromRedis}}    redis.cacheNodes.apply(nodes => nodes[0].address),
    redis.cacheNodes.apply(nodes => nodes[0].port.toString()),
{{/if}}{{#if envFromBucket}}    bucket.bucket,
{{/if}}  ])
  .apply((vals) => {
    let i = 0;
{{#if envFromDb}}    const dbEndpoint = vals[i++] as string;
    const dbPass = vals[i++] as string;
{{/if}}{{#if envFromRedis}}    const rHost = vals[i++] as string;
    const rPort = vals[i++] as string;
{{/if}}{{#if envFromBucket}}    const bucketName = vals[i++] as string;
{{/if}}    const out: Array<{ name: string; value: string }> = [];
{{#if envFromNodeEnv}}    out.push({ name: "NODE_ENV", value: "production" });
{{/if}}{{#if envFromDb}}    out.push({ name: "DATABASE_URL", value: `postgresql://postgres:${dbPass}@${dbEndpoint}/{{@root.database.dbName}}` });
{{/if}}{{#if envFromRedis}}    out.push({ name: "REDIS_URL", value: `redis://${rHost}:${rPort}` });
{{/if}}{{#if envFromBucket}}    out.push({ name: "AWS_S3_BUCKET", value: bucketName });
{{/if}}{{#if envFromRegion}}    out.push({ name: "AWS_S3_REGION", value: region });
{{/if}}{{#each envLiteral}}    out.push({ name: "{{name}}", value: {{jsonString value}} });
{{/each}}{{#if isFrontend}}    out.push({ name: "PORT", value: "{{port}}" });
    out.push({ name: "NEXT_PUBLIC_APP_DOMAIN", value: rootDomain });
{{/if}}    return out;
  });

const {{camel name}}Secrets = pulumi
  .all([
{{#each secrets}}    {{varName}}.arn,
{{/each}}  ])
  .apply((arns) => {
    const out: Array<{ name: string; valueFrom: string }> = [];
{{#each secrets}}    out.push({ name: "{{envVar}}", valueFrom: arns[{{@index}}] as string });
{{/each}}    return out;
  });

const {{camel name}}TaskDef = new aws.ecs.TaskDefinition(`${prefix}-{{name}}-task`, {
  family: `${prefix}-{{name}}`,
  networkMode: "awsvpc",
  requiresCompatibilities: ["FARGATE"],
  cpu: "{{cpuValue}}",
  memory: "{{memoryValue}}",
  executionRoleArn: executionRole.arn,
  taskRoleArn: {{#if isFrontend}}executionRole.arn{{else}}{{camel name}}TaskRole.arn{{/if}},
  containerDefinitions: pulumi
    .all([{{camel name}}Environment, {{camel name}}Secrets])
    .apply(([envArr, secretsArr]) => JSON.stringify([{
      name: "{{name}}",
      image: ecrImage,
      essential: true,
      command: ["sh", "-c", {{jsonString command}}],
{{#if isBackend}}      portMappings: [{ containerPort: {{port}}, protocol: "tcp" }],
{{/if}}{{#if isFrontend}}      portMappings: [
        { containerPort: {{port}}, protocol: "tcp" },
{{#if wildcard}}        { containerPort: {{wildcardPort}}, protocol: "tcp" },
{{/if}}      ],
{{/if}}      environment: envArr,
      secrets: secretsArr,
      logConfiguration: {
        logDriver: "awslogs",
        options: {
          "awslogs-group": `/ecs/${prefix}/{{name}}`,
          "awslogs-region": region,
          "awslogs-stream-prefix": "{{name}}",
        },
      },
    }])),
});

export const {{camel name}}Service = new aws.ecs.Service(`${prefix}-{{name}}-service`, {
  name: `${prefix}-{{name}}`,
  cluster: cluster.arn,
  taskDefinition: {{camel name}}TaskDef.arn,
  desiredCount: {{scaling.min}},
  launchType: "FARGATE",
  enableExecuteCommand: {{@root.ecsDefaults.ecsExec}},
  networkConfiguration: {
    subnets: [privateSubnet1.id, privateSubnet2.id],
    securityGroups: [ecsSg.id],
    assignPublicIp: false,
  },
{{#if hasDomain}}  loadBalancers: [
    { targetGroupArn: {{targetGroupVar}}.arn, containerName: "{{name}}", containerPort: {{port}} },
{{#if wildcardTargetGroupVar}}    { targetGroupArn: {{wildcardTargetGroupVar}}.arn, containerName: "{{name}}", containerPort: {{wildcardPort}} },
{{/if}}  ],
{{/if}}  deploymentCircuitBreaker: { enable: {{@root.ecsDefaults.circuitBreaker}}, rollback: {{@root.ecsDefaults.circuitBreaker}} },
  tags: { Name: `${prefix}-{{name}}` },
});

{{#if scalable}}
const {{camel name}}ScalingTarget = new aws.appautoscaling.Target(`${prefix}-{{name}}-scaling`, {
  maxCapacity: {{scaling.max}},
  minCapacity: {{scaling.min}},
  resourceId: pulumi.interpolate`service/${cluster.name}/${ {{~camel name~}} Service.name}`,
  scalableDimension: "ecs:service:DesiredCount",
  serviceNamespace: "ecs",
});

new aws.appautoscaling.Policy(`${prefix}-{{name}}-cpu-scaling`, {
  name: `${prefix}-{{name}}-cpu-scaling`,
  policyType: "TargetTrackingScaling",
  resourceId: {{camel name}}ScalingTarget.resourceId,
  scalableDimension: {{camel name}}ScalingTarget.scalableDimension,
  serviceNamespace: {{camel name}}ScalingTarget.serviceNamespace,
  targetTrackingScalingPolicyConfiguration: {
    predefinedMetricSpecification: {
      predefinedMetricType: "ECSServiceAverageCPUUtilization",
    },
    targetValue: {{scaling.cpuTarget}},
  },
});
{{/if}}
{{/each}}
