import * as aws from "@pulumi/aws";
import { prefix, rootDomain } from "../config";
import { vpc, publicSubnet1, publicSubnet2, albSg } from "./networking";

export const cert = new aws.acm.Certificate(`${prefix}-cert`, {
  domainName: `*.${rootDomain}`,
  subjectAlternativeNames: [rootDomain],
  validationMethod: "DNS",
  tags: { Name: `${prefix}-cert` },
});

export const alb = new aws.lb.LoadBalancer(`${prefix}-alb`, {
  name: `${prefix}-alb`,
  internal: false,
  loadBalancerType: "application",
  securityGroups: [albSg.id],
  subnets: [publicSubnet1.id, publicSubnet2.id],
  tags: { Name: `${prefix}-alb` },
});

{{#each servicesWithDomain}}
export const {{targetGroupVar}} = new aws.lb.TargetGroup(`${prefix}-{{name}}-tg`, {
  name: `${prefix}-{{name}}-tg`,
  port: {{port}},
  protocol: "HTTP",
  vpcId: vpc.id,
  targetType: "ip",
  healthCheck: {
    path: "{{healthCheck.path}}",
    matcher: "{{healthCheck.codes}}",
    interval: {{@root.ecsDefaults.healthCheckInterval}},
    timeout: {{@root.ecsDefaults.healthCheckTimeout}},
    healthyThreshold: {{@root.ecsDefaults.healthyThreshold}},
    unhealthyThreshold: {{@root.ecsDefaults.unhealthyThreshold}},
  },
  tags: { Name: `${prefix}-{{name}}-tg` },
});

{{#if wildcardTargetGroupVar}}
export const {{wildcardTargetGroupVar}} = new aws.lb.TargetGroup(`${prefix}-{{name}}-wildcard-tg`, {
  name: `${prefix}-{{name}}-wc-tg`,
  port: {{wildcardPort}},
  protocol: "HTTP",
  vpcId: vpc.id,
  targetType: "ip",
  healthCheck: {
    path: "{{healthCheck.path}}",
    matcher: "{{healthCheck.codes}}",
    interval: {{@root.ecsDefaults.healthCheckInterval}},
    timeout: {{@root.ecsDefaults.healthCheckTimeout}},
    healthyThreshold: {{@root.ecsDefaults.healthyThreshold}},
    unhealthyThreshold: {{@root.ecsDefaults.unhealthyThreshold}},
  },
  tags: { Name: `${prefix}-{{name}}-wildcard-tg` },
});
{{/if}}
{{/each}}

new aws.lb.Listener(`${prefix}-http-listener`, {
  loadBalancerArn: alb.arn,
  port: 80,
  protocol: "HTTP",
  defaultActions: [{
    type: "redirect",
    redirect: {
      port: "443",
      protocol: "HTTPS",
      statusCode: "HTTP_301",
    },
  }],
});

const httpsListener = new aws.lb.Listener(`${prefix}-https-listener`, {
  loadBalancerArn: alb.arn,
  port: 443,
  protocol: "HTTPS",
  certificateArn: cert.arn,
  defaultActions: [{
    type: "forward",
    targetGroupArn: {{defaultTargetGroupVar}}.arn,
  }],
});

{{#each servicesWithDomainSorted}}
new aws.lb.ListenerRule(`${prefix}-{{name}}-rule`, {
  listenerArn: httpsListener.arn,
  priority: {{priority @index}},
  conditions: [{ hostHeader: { values: ["{{domain}}"] } }],
  actions: [{ type: "forward", targetGroupArn: {{targetGroupVar}}.arn }],
});
{{/each}}

{{#each wildcardRules}}
new aws.lb.ListenerRule(`${prefix}-{{name}}-wildcard-rule`, {
  listenerArn: httpsListener.arn,
  priority: {{priority}},
  conditions: [{ hostHeader: { values: [`*.${rootDomain}`] } }],
  actions: [{ type: "forward", targetGroupArn: {{wildcardTargetGroupVar}}.arn }],
});
{{/each}}
