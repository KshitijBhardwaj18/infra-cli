{
  "name": "@heizen/infra-cli",
  "version": "0.1.0",
  "description": "Provision AWS ECS infrastructure with a single command",
  "type": "module",
  "bin": {
    "heizen": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "src/generator/templates"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-templates.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@heizen-labs/secrets-sdk": "^1.0.3",
    "@inquirer/prompts": "^7.2.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.5.0",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
