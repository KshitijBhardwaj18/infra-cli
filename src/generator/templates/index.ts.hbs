{{#if hasAlb}}import { alb, cert } from "./components/loadbalancer";
{{/if}}import {
{{#if hasDatabase}}  db,
{{/if}}{{#if hasCache}}  redis,
{{/if}}{{#if hasStorage}}  bucket,
{{/if}}
} from "./components/store";
import { cluster{{#each services}}, {{camel name}}Service{{/each}} } from "./components/compute";
import { vpc } from "./components/networking";

{{#if hasAlb}}export const albDns = alb.dnsName;
export const certValidation = cert.domainValidationOptions;
{{/if}}export const clusterName = cluster.name;
{{#each services}}export const {{camel name}}ServiceName = {{camel name}}Service.name;
{{/each}}
{{#if hasDatabase}}export const dbEndpoint = db.endpoint;
{{/if}}{{#if hasCache}}export const redisEndpoint = redis.cacheNodes.apply(nodes => nodes[0].address);
{{/if}}{{#if hasStorage}}export const bucketName = bucket.bucket;
{{/if}}export const vpcId = vpc.id;
